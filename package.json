{
  "name": "seatwise",
  "private": true,
  "version": "0.1.0",
  "description": "AI course planner for USC students, delivered as an MCP server.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:mcp": "npm run dev -w @seatwise/mcp",
    "dev:web": "npm run dev -w @seatwise/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
