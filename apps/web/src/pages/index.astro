---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import UrlSign from "../components/UrlSign.astro";
import { GITHUB_URL, SITE_DESCRIPTION, SITE_NAME } from "../config";

const title = "Seatwise: plan your USC classes with Claude";
const canonical = new URL("/", Astro.site).toString();
const ogImage = new URL("/og.png", Astro.site).toString();

// Setup steps. [[Label]] marks a button or menu name exactly as the app shows it.
// Sources: Claude and OpenAI help centers, checked 2026-11-21. Re-check after each app redesign.
type Step = { do: string; detail?: string };

const link = (href: string, text: string) => `<a href="${href}" rel="noopener">${text}</a>`;

const steps: Record<"claude" | "chatgpt", Step[]> = {
  claude: [
    {
      do: "In Claude on the web or the desktop app, open [[Customize]], then [[Connectors]].",
      detail: `Shortcut: ${link("https://claude.ai/customize/connectors", "claude.ai/customize/connectors")}`,
    },
    {
      do: "Click [[+ Add]], then [[Add custom connector]].",
      detail: "If you see [[Custom]] instead, hover it and pick [[Web]].",
    },
    {
      do: "Type Seatwise as the name, paste the URL above and click [[Continue]].",
    },
    {
      do: "Under Authentication, pick [[No sign in]], leave Request headers empty and click [[Add]].",
      detail: "Seatwise needs no account and no password.",
    },
    {
      do: "Start a new chat, click [[+]] at the bottom left, open [[Connectors]] and switch Seatwise on.",
      detail: "You need to switch it on in each new chat.",
    },
  ],
  chatgpt: [
    {
      do: "On chatgpt.com in a browser, open [[Plugins]].",
      detail: `Shortcut: ${link("https://chatgpt.com/plugins", "chatgpt.com/plugins")}. The phone app can’t add connectors.`,
    },
    { do: "Click the [[+]] button, then [[Add custom MCP server]]." },
    { do: "Type Seatwise as the name and paste the URL above under [[Connection]]." },
    {
      do: "Choose no authentication, tick [[I understand and want to continue]] and click [[Create as a plugin]].",
    },
    {
      do: "Start a new chat, type @, pick Seatwise and ask your question.",
      detail: "Pick it again when a follow-up needs fresh data.",
    },
  ],
};

const ui = (s: string) => s.replace(/\[\[(.+?)\]\]/g, '<b class="ui">$1</b>');

// Real reply from the live server (check_eligibility, Spring 2027), fetched 2026-11-21.
// Kept verbatim apart from the markdown markers, which are rendered as bold.
const example = `Term 20271. 2 eligible, 1 blocked.

### CSCI 353 (Internetworking): **blocked**
Blocked by: prerequisites.
- [fail] prerequisites: Prerequisites not met. Requires: CSCI 201. If equivalent coursework was completed elsewhere (AP, transfer, home university), list its USC equivalent in completedCourses or ask the department for a prerequisite override.
- [info] recommended_prep: Recommended preparation (not enforced): Familiarity with C and C++.
- [info] duplicate_credit: Duplicates credit with: EE 450.

### BUAD 307 (Marketing Fundamentals): **eligible**
No published restriction or requisite blocks registration.

### CSCI 270 (Introduction to Algorithms and Theory of Computing): **eligible**
No published restriction or requisite blocks registration.
- [pass] prerequisites: Prerequisites met: (CSCI 104 or CSCI 114) and CSCI 170.
- [info] duplicate_credit: Duplicates credit with: former CSCI 303.`;

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const exampleHtml = esc(example)
  .replace(/^### (.+)$/gm, "<strong>$1</strong>")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\[(fail)\]/g, '<span class="out-fail">[$1]</span>')
  .replace(/\[(pass)\]/g, '<span class="out-pass">[$1]</span>');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17121b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Seatwise: plan your USC classes with Claude." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/barlow-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Review aid: ?theme=light or ?theme=dark pins a theme; otherwise the system setting wins.
      var t = new URLSearchParams(location.search).get("theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="top">
      <a class="brand" href="/" translate="no">
        <img src="/logo-ink.svg" alt="" width="24" height="24" />
        Seatwise
      </a>
      <a class="top-link" href={GITHUB_URL} rel="noopener">GitHub</a>
    </header>

    <main id="main" class="page">
      <h1>Plan your USC classes by asking Claude.</h1>

      <div class="note">
        <p>
          I’m Pablo, an exchange student at USC from UC3M in Madrid. Registering for classes here took me far longer
          than it should have. Some classes I wanted were only open to certain majors, others had prerequisites or
          needed D-clearance, and the sections that still had seats often clashed with each other. Working that out
          meant a lot of tabs.
        </p>
        <p>
          So I built Seatwise. It’s a connector that lets Claude read USC’s public Schedule of Classes. You tell Claude
          what you want in your own words, and it checks restrictions, prerequisites, D-clearance, times and open seats
          for you, then puts together a week with no clashes.
        </p>
      </div>

      <section aria-labelledby="example-title">
        <h2 id="example-title">A real example</h2>
        <p>
          Someone who has passed CSCI 104 and CSCI 170 asks whether they can take CSCI 270, CSCI 353 and BUAD 307 in
          Spring 2027. This is what Seatwise sends back to Claude:
        </p>
        <figure class="out">
          <pre set:html={exampleHtml} />
          <figcaption>
            From the live server, 21 November 2026. Claude then explains it in plain words and suggests what to do next,
            like asking the CS department about a prerequisite override.
          </figcaption>
        </figure>
      </section>

      <section id="connect" aria-labelledby="connect-title">
        <h2 id="connect-title">Add it to Claude</h2>
        <p>It takes about a minute, and Claude’s free plan is enough. You only do this once.</p>

        <UrlSign id="url-connect" label="Seatwise URL" />

        <div class="tabs" data-tabs>
          <div class="tablist" role="tablist" aria-label="Choose your assistant">
            <button type="button" role="tab" id="tab-claude" aria-controls="panel-claude" aria-selected="true">Claude</button>
            <button type="button" role="tab" id="tab-chatgpt" aria-controls="panel-chatgpt" aria-selected="false" tabindex="-1">ChatGPT</button>
            <button type="button" role="tab" id="tab-dev" aria-controls="panel-dev" aria-selected="false" tabindex="-1">On your computer</button>
          </div>

          <div class="panel" role="tabpanel" id="panel-claude" aria-labelledby="tab-claude" tabindex="0">
            <h3 class="panel-title">Claude</h3>
            <ol class="steps">
              {steps.claude.map((s) => (
                <li>
                  <p set:html={ui(s.do)} />
                  {s.detail && <p class="step-detail" set:html={ui(s.detail)} />}
                </li>
              ))}
            </ol>
            <p class="panel-note">
              Works on Claude Free (one custom connector), Pro and Max. On a Team or Enterprise account, a workspace
              owner adds it under Organization settings, then Connectors. On the phone app, add it on the web first and it
              shows up in the app.
            </p>
          </div>

          <div class="panel" role="tabpanel" id="panel-chatgpt" aria-labelledby="tab-chatgpt" tabindex="0">
            <h3 class="panel-title">ChatGPT</h3>
            <ol class="steps">
              {steps.chatgpt.map((s) => (
                <li>
                  <p set:html={ui(s.do)} />
                  {s.detail && <p class="step-detail" set:html={ui(s.detail)} />}
                </li>
              ))}
            </ol>
            <p class="panel-note">
              For now, OpenAI offers custom connectors mainly on ChatGPT Business, Enterprise and Edu, and on Business
              only an admin can add one. If you don’t see Plugins on Free or Plus, use Claude’s free plan instead.
            </p>
          </div>

          <div class="panel" role="tabpanel" id="panel-dev" aria-labelledby="tab-dev" tabindex="0">
            <h3 class="panel-title">On your computer</h3>
            <p>
              If you use Claude Code or Claude Desktop, you can run Seatwise locally instead.{" "}
              <a href={GITHUB_URL} rel="noopener">Instructions on GitHub<Icon name="external" class="icon-inline" /></a>
            </p>
          </div>
        </div>

        <p>
          Then just ask. For example: “I’m an exchange student in computer science. Which CSCI classes can I take in
          Spring 2027, with nothing before 10am and Fridays free?”
        </p>
      </section>

      <section aria-labelledby="limits-title">
        <h2 id="limits-title">What it does, and what it doesn’t</h2>
        <ul class="list">
          <li>It searches every section for the term, with times, instructors and open seats.</li>
          <li>It checks major and school restrictions, prerequisites and D-clearance for each class.</li>
          <li>It builds schedules without time clashes and follows your rules, like no 8am classes or a unit cap.</li>
          <li>If you paste your STARS report or transcript into the chat, Claude plans around what you’ve done.</li>
        </ul>
        <ul class="list">
          <li>It doesn’t register you. You still do that in WebReg.</li>
          <li>
            It never asks for your NetID or password and doesn’t store anything about you. It only reads public course
            listings.
          </li>
          <li>Seat counts can be a few minutes behind WebReg.</li>
          <li>
            Some requirements only appear in free-text notes and can be missed. When in doubt, check with the
            department.
          </li>
        </ul>
      </section>

      <p class="signoff">
        Seatwise is free and open source. It’s a side project, not a USC service. If something is wrong or missing,{" "}
        <a href={GITHUB_URL} rel="noopener">open an issue on GitHub</a>.
      </p>
    </main>

    <footer class="foot">
      <p>Not affiliated with or endorsed by the University of Southern California. Course data from the public USC Schedule of Classes.</p>
    </footer>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
