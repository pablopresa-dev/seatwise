---
// Seat strip: 20 identical ticks, each one twentieth of the section. Hollow ticks are open seats.
interface Props {
  open: number;
  total: number;
}
const { open, total } = Astro.props;
const TICKS = 20;
const openTicks = open === 0 ? 0 : Math.max(1, Math.round((open / total) * TICKS));
---

<span class:list={["seats", { "seats-full": open === 0 }]}>
  <span class="ticks" aria-hidden="true">
    {Array.from({ length: TICKS }, (_, i) => <i class:list={{ open: i >= TICKS - openTicks }} />)}
  </span>
  <span>{open === 0 ? `Full (${total} seats)` : `${open} of ${total} open`}</span>
</span>
